require('dotenv').config();
const { ClobClient, OrderType } = require('@polymarket/clob-client');
const { createWalletClient, http } = require('viem');
const { privateKeyToAccount } = require('viem/accounts');
const { polygon } = require('viem/chains');
const WebSocket = require('ws'); 

// --- SECURITY & AUTH ---
let rawKey = process.env.PRIVATE_KEY;
if (!rawKey) throw new Error("CRITICAL: PRIVATE_KEY is missing from .env file!");
if (!rawKey.startsWith('0x')) rawKey = '0x' + rawKey; 

const CHAIN_ID = 137; 
const HOST = 'https://clob.polymarket.com';

// --- STRATEGY CONFIG ---
const TAKE_PROFIT_CENTS      = 0.05;   

// --- VOLATILITY (PROBABILITY) SETTINGS ---
// $0.50 represents maximum volatility (a 50/50 coin toss).
// Distance is how far the price is from $0.50.

// Entry Settings (Enter when price gets close to $0.50)
const ENTRY_DISTANCE         = 0.15;   // Enter trade if Ask price is between $0.35 and $0.65

// Stop Loss Settings
const MAX_DRAWDOWN_EXTREME   = 0.25;   // Allowed drop when volatility is extreme (price near $0.50)
const MAX_DRAWDOWN_LOW       = 0.05;   // Allowed drop when volatility is low (price far from $0.50)

const BET_SIZE_USD           = 1.00;   // Safest size for live testing
const TAKER_FEE_BPS          = 150;    // 1.5% fee

// --- STATE MANAGEMENT ---
// Consolidated into a single, fast state object
let trade = { active: false, side: null, tokenId: null, entryPrice: 0, sellOrderId: null };

let isExecuting = false;
let isSearchingNextMarket = false;
let searchCooldownTimer = 0; 

let currentYesToken = null;
let currentNoToken = null;
let marketEndTime = 0;

let clobClient;

// ─────────────────────────────────────────────────────────
// EXECUTION: ENTRY & EXIT (PLAN A: TAKE PROFIT)
// ─────────────────────────────────────────────────────────
async function executeTradeSequence(side, tokenId, askPrice) {
    if (isExecuting) return; 
    isExecuting = true;

    try {
        const shares = (BET_SIZE_USD / askPrice).toFixed(2);
        console.log(`\n[TRIGGER] ${side} Ask at $${askPrice} in volatility zone. Sending FOK...`);

        const buyOrder = await clobClient.createOrder({
            tokenID: tokenId, price: askPrice, side: 'BUY', size: shares, feeRateBps: TAKER_FEE_BPS, orderType: OrderType.FOK 
        });
        const buyResponse = await clobClient.postOrder(buyOrder);

        if (buyResponse && buyResponse.success && buyResponse.status !== 'CANCELED') {
            console.log(`[BUY FILLED] Bought ${shares} ${side} @ $${askPrice}`);

            const feeCostPerShare = askPrice * (TAKER_FEE_BPS / 10000);
            const targetPriceRaw = askPrice + TAKE_PROFIT_CENTS + feeCostPerShare;
            const takeProfitPrice = parseFloat(targetPriceRaw.toFixed(2));

            console.log(`[EXIT SET] Placing Maker Limit Sell @ $${takeProfitPrice}...`);

            const sellOrder = await clobClient.createOrder({
                tokenID: tokenId, price: takeProfitPrice, side: 'SELL', size: shares, feeRateBps: TAKER_FEE_BPS, orderType: OrderType.GTC 
            });
            const sellResponse = await clobClient.postOrder(sellOrder);

            if (sellResponse && sellResponse.success) {
                console.log(`[TRADE LIVE] Limit Sell resting (ID: ${sellResponse.orderID})`);
                trade.active = true; 
                trade.side = side; 
                trade.tokenId = tokenId; 
                trade.entryPrice = askPrice; 
                trade.sellOrderId = sellResponse.orderID;
            } else {
                console.error(`[CRITICAL] Limit Sell failed! Locking trade to prevent infinite buys. Triggering Smart Exit Hunter...`);
                trade.active = true; 
                trade.side = side; 
                trade.tokenId = tokenId; 
                trade.entryPrice = askPrice;
                // sellOrderId remains null, which activates the Smart Exit Hunter
            }
        } else {
            console.log(`[ENTRY REJECTED] Ghost liquidity or insufficient funds. Order killed.`);
        }
    } catch (err) {
        console.error(`[EXECUTION ERROR]:`, err.message);
    } finally {
        isExecuting = false;
    }
}

// ─────────────────────────────────────────────────────────
// SMART EXIT HANDLER (PLAN B: The Take Profit Hunter)
// ─────────────────────────────────────────────────────────
async function executeSmartExit(bidPrice) {
    trade.sellOrderId = "pending_smart_exit";
    
    console.log(`\n[SMART EXIT TRIGGERED] Target spotted at $${bidPrice}! Firing FOK...`);
    
    try {
        const shares = (BET_SIZE_USD / trade.entryPrice).toFixed(2);
        const exitOrder = await clobClient.createOrder({
            tokenID: trade.tokenId, price: bidPrice, side: 'SELL', size: shares, feeRateBps: TAKER_FEE_BPS, orderType: OrderType.FOK 
        });
        const res = await clobClient.postOrder(exitOrder);
        
        if (res && res.success && res.status !== 'CANCELED') {
             console.log(`[$$$ SMART EXIT PROFIT] Bag saved! Sold at $${bidPrice}`);
             resetTradeState();
        } else {
             console.log(`[SMART EXIT MISSED] Liquidity vanished. Unlocking to hunt again...`);
             trade.sellOrderId = null; 
        }
    } catch (e) {
        console.error(`[SMART EXIT ERROR]:`, e.message);
        trade.sellOrderId = null; 
    }
}

// ─────────────────────────────────────────────────────────
// PROBABILITY-BASED STOP LOSS EXECUTOR
// ─────────────────────────────────────────────────────────
async function executeStopLossDump() {
    const restingOrderId = trade.sellOrderId;
    trade.sellOrderId = "pending_stop_loss"; 

    try {
        if (restingOrderId && restingOrderId !== "pending_smart_exit") {
            console.log(`[STOP LOSS] Canceling resting Limit Sell to free shares...`);
            await clobClient.cancelOrder({ orderID: restingOrderId });
        }

        console.log(`[STOP LOSS DUMP] Firing Market Sell...`);
        const shares = (BET_SIZE_USD / trade.entryPrice).toFixed(2);
        
        const exitOrder = await clobClient.createOrder({
            tokenID: trade.tokenId, price: 0.01, side: 'SELL', size: shares, feeRateBps: TAKER_FEE_BPS, orderType: OrderType.FOK 
        });
        const res = await clobClient.postOrder(exitOrder);
        
        if (res && res.success && res.status !== 'CANCELED') {
             console.log(`[-$ STOP LOSS EXECUTED] Bag liquidated to protect capital.`);
             resetTradeState();
        } else {
             console.log(`[STOP LOSS FAILED] Unlocking trade. Will retry...`);
             trade.sellOrderId = restingOrderId; 
        }
    } catch (e) {
        console.error(`[STOP LOSS ERROR]:`, e.message);
        trade.sellOrderId = restingOrderId;
    }
}

function resetTradeState() {
    trade = { active: false, side: null, tokenId: null, entryPrice: 0, sellOrderId: null };
}

// ─────────────────────────────────────────────────────────
// MARKET ROLLOVER ENGINE
// ─────────────────────────────────────────────────────────
async function loadNextMarket() {
    if (isSearchingNextMarket) return;
    if (Date.now() < searchCooldownTimer) return; 

    isSearchingNextMarket = true;
    console.log('\n[SCANNER] Searching for the next 5-Min BTC Market...');
    
    try {
        const markets = await clobClient.getMarkets();
        const activeMarkets = markets.data.filter(m => m.active && !m.closed);

        const btcMarkets = activeMarkets.filter(m => 
            m.event_slug && m.event_slug.toLowerCase().includes('btc-updown-5m')
        );

        if (!btcMarkets.length) {
            console.log('[SCANNER ALERT] I cannot find the exact slug.');
            searchCooldownTimer = Date.now() + 30000;
            return;
        }

        const sorted = btcMarkets.sort((a, b) => new Date(a.end_date_iso) - new Date(b.end_date_iso));
        const now = Date.now();
        const validMarket = sorted.find(m => {
            const timeRemaining = Math.floor((new Date(m.end_date_iso).getTime() - now) / 1000);
            return timeRemaining > 10; // Ensure market hasn't instantly expired
        });

        if (validMarket) {
            currentYesToken = validMarket.tokens.find(t => t.outcome === 'Yes').token_id;
            currentNoToken  = validMarket.tokens.find(t => t.outcome === 'No').token_id;
            marketEndTime   = new Date(validMarket.end_date_iso).getTime();
            
            console.log(`[MARKET LOADED] Subscribing to: ${validMarket.question}`);
            
            if (global.wsMarket && global.wsMarket.readyState === WebSocket.OPEN) {
                global.wsMarket.send(JSON.stringify({
                    type: "market", assets_ids: [currentYesToken, currentNoToken]
                }));
            }
        } else {
            searchCooldownTimer = Date.now() + 30000;
        }
    } catch (err) {
        console.error('[MARKET ERROR]', err.message);
        searchCooldownTimer = Date.now() + 30000; 
    } finally {
        isSearchingNextMarket = false;
    }
}

// ─────────────────────────────────────────────────────────
// WEBSOCKET HANDLERS
// ─────────────────────────────────────────────────────────
function handleMarketUpdate(data) {
    if (!data) return;

    const bestAsk = data.asks && data.asks.length > 0 ? parseFloat(data.asks[0].price) : null;
    const bestBid = data.bids && data.bids.length > 0 ? parseFloat(data.bids[0].price) : null;
    const tokenId = data.asset_id;
    const side = data.asset_id === currentYesToken ? 'YES' : 'NO';

    // --- ACTIVE TRADE MANAGEMENT ---
    if (trade.active && trade.tokenId === tokenId && bestBid !== null) {
        
        // 1. SMART EXIT HUNTER (Plan B: Take Profit)
        if (!trade.sellOrderId) {
            const feeCostPerShare = trade.entryPrice * (TAKER_FEE_BPS / 10000);
            const targetPrice = trade.entryPrice + TAKE_PROFIT_CENTS + feeCostPerShare;

            if (bestBid >= targetPrice) {
                executeSmartExit(bestBid);
                return; // Stop processing this tick if exiting
            }
        }

        // 2. PROBABILITY-BASED DYNAMIC STOP LOSS
        if (trade.sellOrderId !== "pending_smart_exit" && trade.sellOrderId !== "pending_stop_loss") {
            // Measure how close we are to 0.50 (maximum volatility)
            const distanceFromStrikeBid = Math.abs(0.50 - bestBid);
            
            // Convert distance to a multiplier: 1 at 0.50, 0 at limits.
            const volatilityMultiplier = 1 - (distanceFromStrikeBid / 0.50);

            // Dynamically scale allowed drawdown based on volatility
            const dynamicTolerance = MAX_DRAWDOWN_LOW + ((MAX_DRAWDOWN_EXTREME - MAX_DRAWDOWN_LOW) * volatilityMultiplier);
            const currentDrawdown = trade.entryPrice - bestBid;

            if (currentDrawdown > dynamicTolerance) {
                console.log(`\n[DYNAMIC STOP-LOSS ALERT] Breached tolerance!`);
                console.log(` -> Drawdown: -$${currentDrawdown.toFixed(2)} | Allowed for current volatility: -$${dynamicTolerance.toFixed(2)}`);
                executeStopLossDump(); 
            }
        }
    }

    // --- 3. PROBABILITY-BASED VOLATILITY ENTRY LOGIC ---
    if (!trade.active && bestAsk !== null) {
        // Measure how close the ask is to 0.50 to detect high volatility for entry
        const distanceFromStrikeAsk = Math.abs(0.50 - bestAsk);

        if (distanceFromStrikeAsk <= ENTRY_DISTANCE) {
            executeTradeSequence(side, tokenId, bestAsk);
        }
    }
}

// ─────────────────────────────────────────────────────────
// BOOT SEQUENCE & TIMERS
// ─────────────────────────────────────────────────────────
async function runLiveTrader() {
    console.log("Booting Single-Bullet Volatility Engine (Viem + Anti-Spam Optimized)...");
    
    const account = privateKeyToAccount(rawKey);
    const walletClient = createWalletClient({ account, chain: polygon, transport: http() });
    clobClient = new ClobClient(HOST, CHAIN_ID, walletClient);

    let creds;
    try { creds = await clobClient.deriveApiKey(); } 
    catch (e) { creds = await clobClient.createApiKey(); }
    const apiKey = creds.apiKey || creds.key;

    const wsMarket = new WebSocket('wss://ws-subscriptions-clob.polymarket.com/ws/market');
    global.wsMarket = wsMarket; 
    
    wsMarket.on('open', () => console.log("[WS] Market Stream Connected."));
    wsMarket.on('message', (msg) => {
        const data = JSON.parse(msg);
        if (data.event === 'book' || data.event === 'price_change') handleMarketUpdate(data);
    });

    const wsUser = new WebSocket('wss://ws-subscriptions-clob.polymarket.com/ws/user');
    wsUser.on('open', () => {
        console.log("[WS] User Stream Connected.");
        wsUser.send(JSON.stringify({
            type: "user", auth: { apikey: apiKey, apiKey: apiKey, secret: creds.secret, passphrase: creds.passphrase }
        }));
    });

    wsUser.on('message', (msg) => {
        const data = JSON.parse(msg);
        if (Array.isArray(data)) {
            for (const order of data) {
                if (order.status === 'FILLED' && trade.active && order.orderID === trade.sellOrderId) {
                    console.log(`\n[$$$ PROFIT] Target Hit! Sold at $${order.price}`);
                    resetTradeState();
                }
            }
        }
    });

    await loadNextMarket();

    setInterval(async () => {
        if (marketEndTime === 0) {
            loadNextMarket();
            return;
        }

        const now = Date.now();
        const secondsLeft = Math.max(0, Math.floor((marketEndTime - now) / 1000));

        // Time is strictly used to roll over into the next active market now
        if (secondsLeft === 0 && !isSearchingNextMarket) loadNextMarket();

        if (secondsLeft % 10 === 0) {
            console.log(`[LIVE] Time: ${secondsLeft}s | Status: ${trade.active ? 'HOLDING ' + trade.side : 'HUNTING'}`);
        }
    }, 1000);
}

runLiveTrader().catch(console.error);
